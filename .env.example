# Copy to server/.env and fill in. Never commit real values.

# --- Server ---
NODE_ENV=development
PORT=4000
# Trusted frontend origin used for email verification links, password recovery links, and CORS:
# - Local desktop dev: http://localhost:5174
# - Local mobile / LAN testing: http://<YOUR_LAN_IP>:5174 (e.g. http://192.168.1.15:5174 or tunnel URL)
# - Production (Render): https://gamequest-five.vercel.app
CLIENT_ORIGIN=http://localhost:5174
MONGODB_URI=
LOG_LEVEL=info

# --- Auth ---
# JWT secrets: random strings of 32+ characters, different from each other
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# optional: max login/register attempts per IP per 15 min (default 20)
# AUTH_RATE_LIMIT_MAX=20
# 32 bytes, base64 — encrypts third-party tokens (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
# Production only (Render): see docs/DEPLOY.md
# COOKIE_SAMESITE=lax
# TRUST_PROXY=2
# PUBLIC_API_URL=https://your-api.onrender.com

# --- Email / Verification & Password Recovery ---
# Standard SMTP configuration (works with Resend SMTP, SendGrid, Postmark, AWS SES, Gmail, Mailtrap, etc.)
# If unset in development, emails are safely logged to console (with token redacted).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to true for port 465 (SSL), false for 587/STARTTLS
SMTP_SECURE=false
EMAIL_FROM="GameQuest <noreply@gamequest.app>"

# --- Content / platforms (needed from the game catalog item onward) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=
YOUTUBE_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# "Continue with Google" on the login page. Google Cloud Console > Credentials > OAuth client (Web application).
# Authorised redirect URI: <PUBLIC_API_URL or http://localhost:PORT>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Client (Vite; public values only, nothing secret) ---
# Not needed: dev uses http://localhost:4000/api/v1 and production uses /api/v1 automatically.
# VITE_API_URL=

