{
  "name": "@gamequest/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --passWithNoTests",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "catalog:import": "node --env-file-if-exists=.env scripts/import-catalog.js",
    "catalog:fix": "node --env-file-if-exists=.env scripts/fix-catalog.js",
    "catalog:steam-art": "node --env-file-if-exists=.env scripts/steam-art.js",
    "db:indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/src/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@gamequest/shared": "^0.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
